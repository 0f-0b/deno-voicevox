{
  "name": "@ud2/deno-voicevox",
  "exports": "./mod.ts",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.shared_globals"],
    "exactOptionalPropertyTypes": true
  },
  "publish": {
    "exclude": [
      ".gitattributes",
      ".github",
      "deno.lock",
      "**/test.ts",
      "**/*_test.ts",
      "**/*_wrapper.cmd"
    ]
  },
  "tasks": {
    "cache": "deno cache examples/simple_tts.ts",
    "lint": "deno fmt --check && deno lint && deno check examples/simple_tts.ts",
    "test": "deno test --allow-read --allow-write --allow-run=./examples/simple_tts.ts,./examples/simple_tts_wrapper.cmd --allow-ffi"
  }
}
